FROM alpine:3.22.2-arm64

# 设置 LANG 环境变量以支持 UTF-8
ENV LANG=C.UTF-8

# 在有网络的情况下，安装 bash 和 tzdata
RUN apk update && \
    apk add bash tzdata && \
    rm -rf /var/cache/apk/*

# 设置时区
ENV TZ=Asia/Shanghai

# 验证
RUN echo "--- Verification ---" && \
    echo "Locale (LANG): $LANG" && \
    echo "Current Time (TZ=$TZ): $(date)" && \
    echo "Bash Path: $(which bash)" && \
    echo "--- End Verification ---"